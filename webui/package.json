{
  "name": "upbrr-webui",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24.0"
  },
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-appearance-bootstrap.mjs && vite",
    "build": "node scripts/build-appearance-bootstrap.mjs && tsc -b && vite build",
    "build:bundle": "node scripts/build-appearance-bootstrap.mjs && vite build",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e:web": "playwright test --project=web-smoke --project=web-base-path-smoke --project=web-full-upload",
    "test:e2e:full": "playwright test",
    "lint": "eslint --cache \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint --cache --fix src --ext .ts,.tsx",
    "lint:style": "stylelint \"src/**/*.css\"",
    "lint:style:fix": "stylelint \"src/**/*.css\" --fix",
    "lint:dead": "knip --include files,exports,dependencies --no-config-hints",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write --cache .",
    "format:check": "prettier --check --cache ."
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-switch": "^1.2.6",
    "@tanstack/react-query": "5.103.2",
    "@tanstack/react-router": "1.170.39",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "happy-dom": "^20.9.0",
    "knip": "^6.14.2",
    "prettier": "^3.8.3",
    "stylelint": "^16.26.1",
    "stylelint-config-recommended": "^17.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
