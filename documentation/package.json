{
  "name": "upbrr-documentation",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "start": "docusaurus start",
    "build": "node --no-experimental-webstorage ./node_modules/@docusaurus/core/bin/docusaurus.mjs build",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear",
    "check": "pnpm run format:check && pnpm run typecheck && pnpm run build",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@easyops-cn/docusaurus-search-local": "0.55.3",
    "@mdx-js/react": "^3.1.1",
    "docusaurus-plugin-llms": "0.5.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "prettier": "^3.8.3",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=24"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  }
}
